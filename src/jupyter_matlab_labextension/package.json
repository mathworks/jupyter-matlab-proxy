{
  "name": "jupyter_matlab_labextension",
  "version": "1.1.0",
  "description": "A JupyterLab extension.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "The MathWorks Inc.",
    "email": "jupyter-support@mathworks.com"
  },
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/mathworks/jupyter-matlab-proxy"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:labextension:dev",
    "build:prod": "npm run clean && npm run build:lib && npm run build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "npm run build:lezer && tsc",
    "build:lezer": "lezer-generator src/lezer-matlab/src/matlab.grammar -o src/lezer-matlab/src/parser && rollup -c src/lezer-matlab/rollup.config.js && npm run copy-lezer-files-on-windows",
    "copy-lezer-files-on-windows": "copy src\\lezer-matlab\\src\\*.js src\\lezer-matlab\\dist\\ || true",
    "clean": "npm run clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:lintcache": "rimraf .eslintcache .stylelintcache",
    "clean:labextension": "rimraf jupyter_matlab_labextension/labextension",
    "clean:all": "npm run clean:lib && npm run clean:labextension && npm run clean:lintcache",
    "eslint": "npm run eslint:check -- --fix",
    "eslint:check": "eslint . --cache --ext .ts,.tsx",
    "install:extension": "npm run build",
    "lint": "npm run stylelint && npm run prettier && npm run eslint",
    "lint:check": "npm run stylelint:check && npm run prettier:check && npm run eslint:check",
    "prettier": "npm run prettier:base -- --write --list-different",
    "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.css,.json,.md}\"",
    "prettier:check": "npm run prettier:base -- --check",
    "stylelint": "npm run stylelint:check -- --fix",
    "stylelint:check": "stylelint --cache \"style/**/*.css\"",
    "test": "jest && npm run build:lezer && npm run test:lezer",
    "test:lezer": "mocha src/lezer-matlab/test/test-*.js",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w",
    "watch:labextension": "jupyter labextension watch ."
  },
  "dependencies": {
    "@codemirror/language": "^6.0.0",
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/codemirror": "^4.0.0",
    "@jupyterlab/coreutils": "^6.0.0",
    "@jupyterlab/docregistry": "^4.0.0",
    "@jupyterlab/launcher": "^4.0.0",
    "@jupyterlab/mainmenu": "^4.3.4",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/ui-components": "^4.0.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/lr": "^1.0.0",
    "@lumino/coreutils": "^2.0.0",
    "@lumino/disposable": "^2.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.5.9",
    "@lezer/generator": "^1.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "cross-spawn": "^6.0.6",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-config-standard-with-typescript": "^22.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.0",
    "jest": "^29.7.0",
    "mocha": "^12.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.7",
    "rimraf": "^4.4.1",
    "rollup": "^4.22.4",
    "semver": ">=5.7.2",
    "ts-jest": "^29.2.5",
    "typescript": "~5.0.2",
    "ws": "^7.5.10"
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyter_matlab_labextension/labextension"
  },
  "jupyter-releaser": {
    "hooks": {
      "before-build-npm": [
        "python -m pip install jupyterlab~=4",
        "npm install"
      ],
      "before-build-python": [
        "npm run clean:all"
      ]
    }
  }
}
